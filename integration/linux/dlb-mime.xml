<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-dlb">
    <comment>DLB archive</comment>
    <magic priority="60">
      <match type="string" offset="0" value="DLB2"/>
      <match type="string" offset="0" value="DLB1"/>
      <match type="string" offset="0" value="DLBE"/>
    </magic>
    <glob pattern="*.dlb"/>
  </mime-type>
</mime-info>
